{
  "version": 2,
  "regions": ["hnd1"],
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "backend/dist/**",
          "backend/apks/AdminApp.apk",
          "backend/apks/TeacherApp.apk",
          "backend/apks/GuardianApp.apk"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/server.js"
    }
  ],
  "crons": [
    { "path": "/api/cron/attendance-access-expiry", "schedule": "0 0 * * *" },
    { "path": "/api/cron/attendance-reminders", "schedule": "0 9 * * *" },
    { "path": "/api/cron/attendance-rollup", "schedule": "0 16 * * *" },
    { "path": "/api/cron/academic-session", "schedule": "5 18 * * *" }
  ]
}
